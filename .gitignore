# 共有フォルダ（大容量・環境依存）
shared/

# ユーザー向け友好フォルダ（host固有のジャンクション集。refresh-user-folders.ps1 が生成）
_ユーザーファイル/

# 環境変数
.env
.env.local

# .mcp.json はホスト固有の絶対パスを含む生成物（.mcp.json.template から install.ps1/.sh が生成）
.mcp.json

# Python
__pycache__/
*.py[cod]
*.pyo
.venv/
venv/
*.egg-info/

# Irodori-TTS-Server ソース（git clone で取得）
tts-agent/irodori-tts-server-src/

# Irodori HFモデルキャッシュ（数GB・初回起動でHFから自動DL。バインドマウントで可視化）
tts-agent/irodori-models/

# omnivoice-server ソース（git clone で取得）
tts-agent/omnivoice-tts-server-src/

# OmniVoice HFモデルキャッシュ（数GB・初回起動でHFから自動DL。バインドマウントで可視化）
tts-agent/omnivoice-models/

# Docker
*.log

# OS
.DS_Store
Thumbs.db

# テスト素材・参考音声（バイナリ）
Test material/
reference/*.wav
tts-agent/voices/*.wav

# pytest キャッシュ
.pytest_cache/

# Claude Code ローカル設定
.claude/

# imagegen-agent モデル・生成物（大容量、READMEのURLから再取得）
imagegen-agent/models/**/*.safetensors
imagegen-agent/models/**/*.ckpt
imagegen-agent/models/**/*.pt
imagegen-agent/models/**/*.pth
imagegen-agent/models/**/*.bin
imagegen-agent/output/

# 背景除去(rembg)のONNXモデル（初回起動で自動DL・バインドマウントで可視化）
scrapping-agent/rembg-models/

# 大容量バイナリ素材（ローカル保持・公開リポジトリには入れない／bind運用）
/Images/
/Voices/
reference/*.png
/Conteiner Flow.png
/Tab flow.png

# 使い捨てスパイク・スクラッチ（FCPXML忠実度調査の再現用ローカルファイル）
editing-agent/tmp/

# ─── 公開リポへの誤コミット防止（非公開資産・自作資産） ─────────────────
# 除外の正本は scripts/public-manifest.json の forbidden_paths_must_be_absent。
# ここはその「保険」で、公開側リポでの `git add -A` 事故を止めるためにある。
#
# ⚠️ この開発リポ（YT-Studio-dev = private）はこれらを**意図的に追跡している**。
#    .gitignore は追跡済みファイルには効かないので、ここに書いても開発側の追跡は壊れない。
#    一方 .gitignore 自体が公開リリースに含まれて公開リポ側へコピーされるため、
#    向こう（未追跡）では確実に無視される＝これが狙い。
psassist/assets/bubbles.psd
psassist/assets/background_overrides.json
psassist/assets/speaker_defaults.json
# models/ 直下は拡張子ルール（上記）でモデル本体だけを弾いていたが、
# README 等の非バイナリが公開リポ側で未追跡のまま残り、誤って混入しうる。
# 公開マニフェストの include にも入っていないのでディレクトリごと無視する。
imagegen-agent/models/
